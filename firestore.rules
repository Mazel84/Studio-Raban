rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /artifacts/studio-raban-prod/public/data/{collection}/{docId} {
      // Tylko zalogowani mogą czytać
      allow read: if request.auth != null;

      // Użytkownicy: mogą edytować tylko swój dokument, nie mogą ustawić roli admin
      allow write: if request.auth != null
        && (collection != 'users' || request.resource.data.email == request.auth.token.email)
        && (collection != 'users' || request.resource.data.role != 'admin');

      // Zlecenia: autor nie zmienia się przy edycji
      allow update: if request.auth != null
        && (collection != 'jobs' || request.resource.data.author == resource.data.author);

      // Nowe zlecenia: autor musi być ustawiony na email tworzącego
      allow create: if request.auth != null
        && (collection != 'jobs' || request.resource.data.author == request.auth.token.email);

      // Nikt nie kasuje zleceń (koszty, sezony, budżety - tak)
      allow delete: if request.auth != null
        && collection != 'jobs';
    }
  }
}
